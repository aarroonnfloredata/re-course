{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "module.yaml",
  "description": "Module metadata. See spec/README.md. Checked by the validator, not by this schema: id equals the folder name, prerequisites are earlier modules, sources equals the lesson's citation IDs.",
  "type": "object",
  "required": [
    "id",
    "title",
    "exercise_type",
    "language",
    "prerequisites",
    "objectives",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/moduleId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "exercise_type": {
      "description": "Names the file in spec/exercise-types/ that applies.",
      "enum": ["implement", "refactor"]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleId"
      }
    },
    "objectives": {
      "description": "Numbered from 1 in this order; everything else refers to them by number.",
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "description": "Citation IDs: <source-id>#<section-id>.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*#[A-Za-z0-9._-]+$"
      }
    },
    "checkpoint": {
      "description": "Cumulative courses only; not yet specified.",
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "moduleId": {
      "description": "NN-kebab-case-title, e.g. 01-strings.",
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
