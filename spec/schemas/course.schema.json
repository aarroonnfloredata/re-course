{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "course.yaml",
  "description": "Course metadata read by the learn runtime. See spec/README.md.",
  "type": "object",
  "required": ["title", "spec_version", "language", "modules"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "const": 1
    },
    "language": {
      "description": "Needs a runtime plugin: runtime/learn/languages/<language>.py.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "modules": {
      "description": "Module IDs in learning order. Each needs modules/<id>/.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleId"
      }
    }
  },
  "$defs": {
    "moduleId": {
      "description": "NN-kebab-case-title, e.g. 01-strings.",
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
